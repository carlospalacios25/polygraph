<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<VBox alignment="CENTER" prefHeight="782.0" prefWidth="984.0" spacing="25" styleClass="root" stylesheets="@../styles.css"
      xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.polygraph.controlador.ExpedienteServicioControlador">

    <!-- ENCABEZADO -->
    <VBox spacing="15" styleClass="form-container">
        <Label text="Expediente del Servicio" styleClass="title-label"/>
        <HBox alignment="CENTER" spacing="12">
            <Circle fx:id="circleEstado" radius="13"/>
            <Label fx:id="lblEstado" styleClass="status-header"/>
            <Label text="•" styleClass="separator-dot"/>
            <Label fx:id="lblServicioId" styleClass="service-id-header"/>
        </HBox>
    </VBox>

    <!-- TARJETA GRANDE CON LAS PESTAÑAS (igual que en Gestión) -->
    <VBox spacing="30" styleClass="form-container">
        <TabPane fx:id="tabPane" styleClass="modern-tabpane" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <!-- INFORMACIÓN GENERAL -->
                <Tab text="Información General">
                    <ScrollPane fitToWidth="true">
                        <VBox spacing="28" style="-fx-padding: 35;">
                            <VBox spacing="12">
                                <Label text="Datos del Servicio" styleClass="subtitle-label"/>
                                <GridPane hgap="20" vgap="14">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="160" hgrow="SOMETIMES"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <Label text="Cliente:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                    <TextField fx:id="txtCliente" editable="false" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                    <Label text="Proceso:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                    <TextField fx:id="txtProceso" editable="false" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                    <Label text="Fecha Solicitud:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                    <TextField fx:id="txtFechaSolicitud" editable="false" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                </GridPane>
                            </VBox>
                            <Separator/>
                            <VBox spacing="16">
                                <Label text="Datos del Candidato" styleClass="subtitle-label"/>
                                <GridPane hgap="15" vgap="12">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <Label text="Cédula:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                    <TextField fx:id="txtCedula" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                    <Label text="Nombre:" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                    <TextField fx:id="txtNombreCand" styleClass="text-field" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                                    <Label text="Apellido:" styleClass="field-label" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
                                    <TextField fx:id="txtApellidoCand" styleClass="text-field" GridPane.columnIndex="5" GridPane.rowIndex="0"/>
                                    <Label text="Teléfono:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                    <TextField fx:id="txtTelefono" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                    <Label text="Dirección:" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                    <TextField fx:id="txtDireccion" styleClass="text-field" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                                    <Label text="Ciudad:" styleClass="field-label" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
                                    <ComboBox fx:id="cbCiudad" styleClass="text-field" GridPane.columnIndex="5" GridPane.rowIndex="1"/>
                                </GridPane>
                                <HBox spacing="15" style="-fx-padding: 20 0 0 0;">
                                    <Button text="Actualizar Candidato" onAction="#actualizarCandidato" styleClass="primary-button"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </ScrollPane>
                </Tab>

                <!-- POLIGRAFÍA -->
                <Tab text="Poligrafía">
                    <ScrollPane fitToWidth="true">
                        <VBox spacing="28" style="-fx-padding: 35;">
                            <GridPane hgap="20" vgap="16">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="180"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="Poligrafista:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <ComboBox fx:id="cbPoligrafista" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <Label text="Fecha de Poligrafía:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <DatePicker fx:id="dpFechaPoligrafia" styleClass="date-picker" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                <Label text="Hora Programada:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <TextField fx:id="txtHoraPoligrafia" promptText="08:30" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            </GridPane>
                            <HBox spacing="15" style="-fx-padding: 15 0 0 0;">
                                <Button text="Guardar Poligrafía" onAction="#guardarPoligrafia" styleClass="success-button"/>
                            </HBox>
                            <Label fx:id="lblStatusPoli" styleClass="status-info" text="Sin poligrafía registrada"/>
                        </VBox>
                    </ScrollPane>
                </Tab>

                <Tab text="Visita Domiciliaria">
                    <ScrollPane fitToWidth="true">
                        <VBox spacing="28" style="-fx-padding: 35;">
                            <GridPane hgap="20" vgap="16">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="180"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Visitador:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <ComboBox fx:id="cbVisitador" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                <Label text="Tipo Prueba:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <ComboBox fx:id="cbTipoPrueba" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label text="Tipo Visita:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <ComboBox fx:id="cbTipoVisita" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                                <Label text="Fecha Solicitud:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <DatePicker fx:id="dpFechaSolicitud" styleClass="date-picker" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                            </GridPane>

                            <HBox spacing="15" style="-fx-padding: 15 0 0 0;">
                                <Button text="Guardar Visita" onAction="#guardarVisita" styleClass="success-button"/>
                            </HBox>

                            <Label fx:id="lblStatusVisita" styleClass="status-info" text="Sin visita registrada"/>
                        </VBox>
                    </ScrollPane>
                </Tab>
            </tabs>
        </TabPane>
    </VBox>
</VBox>