<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.polygraph.controlador.VisitadoresController"
      alignment="CENTER" prefHeight="350.0" prefWidth="480.0" spacing="20"
      styleClass="root" stylesheets="@../styles.css">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <!-- PANEL BLANCO -->
    <VBox alignment="CENTER" prefHeight="280.0" prefWidth="420.0" spacing="20" styleClass="form-container">

        <!-- TÍTULO -->
        <Label text="Agregar Visitador" styleClass="title-label"/>

        <!-- CAMPO NOMBRE -->
        <VBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Nombre del visitador:" styleClass="label"/>
            <TextField fx:id="nombreVisitadorField"
                       promptText="Ej: Juan Pérez Gómez"
                       prefWidth="360" styleClass="text-field"/>
        </VBox>

        <!-- CAMPO ZONAS -->
        <VBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Zonas asignadas:" styleClass="label"/>
            <TextField fx:id="zonasVisitadorField"
                       promptText="Ej: Norte, Sur, Centro"
                       prefWidth="360" styleClass="text-field"/>
        </VBox>

        <!-- BOTONES -->
        <HBox alignment="CENTER" spacing="15">
            <Button text="Crear Visitador" onAction="#insertarVisitador" styleClass="button"/>
        </HBox>

        <!-- MENSAJE DE ERROR/ÉXITO -->
        <Label fx:id="errorLabel" styleClass="error-label" text=""
               style="-fx-padding: 5 0 0 0; -fx-min-height: 20;"/>
    </VBox>
</VBox>