<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="745.0" prefWidth="900.0" spacing="20" styleClass="root" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.polygraph.controlador.GestionProgresoControlador">
    <children>

        <!-- ====================== BUSCADOR ====================== -->
        <TextField fx:id="buscadorField" prefWidth="400.0" promptText="Buscar por cédula, nombre, cliente, proceso..." styleClass="text-field" />

        <!-- ====================== TARJETAS ====================== -->
        <ScrollPane fitToWidth="true" prefHeight="646.0" prefWidth="900.0" styleClass="form-container">
            <GridPane fx:id="serviciosContainer" hgap="25" styleClass="form-container" vgap="25" />
        </ScrollPane>

    </children>
</VBox>
