<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.polygraph.controlador.PoligrafistasController"
      alignment="CENTER" prefHeight="350.0" prefWidth="480.0" spacing="20"
      styleClass="root" stylesheets="@../styles.css">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <VBox alignment="CENTER" spacing="20" styleClass="form-container">
        
        <Label text="Agregar Poligrafista" styleClass="title-label"/>

        <!-- Nombre del poligrafista -->
        <VBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Nombre completo:" styleClass="label"/>
            <TextField fx:id="nombrePoligrafistaField"
                       promptText="Ej: Juan David Pérez"
                       prefWidth="360" styleClass="text-field"/>
        </VBox>

        <!-- Sala encargada -->
        <VBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Sala encargada:" styleClass="label"/>
            <TextField fx:id="salaEncargadaField"
                       promptText="Ej: Sala 1, Sala Norte, Móvil"
                       prefWidth="360" styleClass="text-field"/>
        </VBox>

        <!-- Botones -->
        <HBox alignment="CENTER" spacing="20">
            <Button text="Guardar Poligrafista" 
                    onAction="#insertarPoligrafista" 
                    styleClass="button"/>
        </HBox>

    </VBox>
</VBox>