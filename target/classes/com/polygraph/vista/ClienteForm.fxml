<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" styleClass="root" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.polygraph.controlador.ClienteController">

    <children>

        <!-- ====================== FORMULARIO ====================== -->
        <VBox prefHeight="422.0" prefWidth="984.0" spacing="15" styleClass="form-container">
            <Label styleClass="title-label" text="Módulo de Cliente" />

            <!-- Recuadro blanco premium con sombra -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15;-fx-border-color: #e2e8f0; -fx-padding: 25;                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);">

                <GridPane hgap="18" vgap="18">
                    <!-- Fila 1 -->
                    <Label style="-fx-font-weight: bold;" text="NIT Cliente:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="nitClienteField" promptText="NIT Cliente" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label style="-fx-font-weight: bold;" text="Nombre Cliente:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <TextField fx:id="nombreClieField" promptText="Nombre Cliente" styleClass="text-field" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                    <!-- Fila 2 -->
                    <Label style="-fx-font-weight: bold;" text="Teléfono Cliente:" GridPane.columnIndex="4" />
                    <TextField fx:id="telefonoClieField" promptText="Teléfono Cliente" styleClass="text-field" GridPane.columnIndex="5" />

                    <Label style="-fx-font-weight: bold;" text="Dirección Cliente:" GridPane.rowIndex="1" />
                    <TextField fx:id="direccionClienField" promptText="Dirección Cliente" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <!-- Fila 3 -->
                    <Label style="-fx-font-weight: bold;" text="Ciudad Cliente:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                    <ComboBox fx:id="cidadesComboBox" promptText="Ciudad Cliente" styleClass="text-field" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="-Infinity" />
                        <ColumnConstraints hgrow="ALWAYS" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="-Infinity" />
                        <ColumnConstraints hgrow="ALWAYS" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="-Infinity" />
                  <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints vgrow="SOMETIMES" />
                        <RowConstraints vgrow="SOMETIMES" />
                        <RowConstraints vgrow="SOMETIMES" />
                    </rowConstraints>
                </GridPane>

                <!-- BOTONES DENTRO del recuadro (los mismos que tenías, bien puestos) -->
                <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 25 0 10 0;">
                    <children>
                        <Button fx:id="btnCrearCliente" onAction="#insertarCliente" text="Crear Cliente" /><!--styleClass="button primary" -->
                        <Button onAction="#cargarForCiudades" text="Agregar Ciudad" />
                    </children>
                </HBox>
            </VBox>
        </VBox>

        <!-- ====================== BUSCADOR ====================== -->
        <TextField fx:id="buscadorField" prefWidth="400.0" promptText="Buscar cliente por NIT, nombre, ciudad..." styleClass="text-field" />

        <!-- ====================== TABLA ====================== -->
        <VBox styleClass="form-container">
            <TableView fx:id="tablaClientes" prefHeight="300.0" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colNitCliente" prefWidth="140" text="NIT" />
                    <TableColumn fx:id="colNomCliente" prefWidth="250" text="Nombre Cliente" />
                    <TableColumn fx:id="colTelCliente" prefWidth="130" text="Teléfono" />
                    <TableColumn fx:id="colCiuCliente" prefWidth="150" text="Ciudad" />
                    <TableColumn fx:id="colAcciones" prefWidth="100" text="Acciones" />
                </columns>
            </TableView>
        </VBox>

    </children>
</VBox>
