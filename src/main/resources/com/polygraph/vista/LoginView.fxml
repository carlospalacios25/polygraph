<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER"
      onMouseDragged="#arrastrarVentana"
      onMousePressed="#iniciarArrastre"
      prefHeight="538.0"
      prefWidth="450.0"
      spacing="18"
      styleClass="root login-bg"
      stylesheets="@../styles_login.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.polygraph.controlador.LoginController">

    <padding>
        <Insets bottom="35" left="45" right="45" top="35" />
    </padding>

    <!-- BOTÓN CERRAR (X) -->
    <HBox alignment="TOP_RIGHT" style="-fx-padding: -25 -40 0 0;">
        <Button onAction="#cerrar" styleClass="btn-cerrar" text="X" />
    </HBox>

    <!-- PANEL BLANCO -->
    <VBox alignment="CENTER" spacing="20" styleClass="login-panel">

        <!-- TÍTULOS SOLO PARA LOGIN -->
        <VBox fx:id="loginHeaderBox" alignment="CENTER" spacing="4">
            <Label styleClass="login-title" text="Polygraph" />
            <Label styleClass="login-subtitle" text="Bienvenido">
                <font>
                    <Font size="13.0" />
                </font>
            </Label>
        </VBox>

        <!-- PESTAÑAS LOGIN / REGISTRO -->
        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="btnTabLogin"
                    text="Iniciar Sesión"
                    onAction="#mostrarLogin"
                    styleClass="btn-login-iniciar" />
            <Button fx:id="btnTabRegistro"
                    text="Registrarse"
                    onAction="#mostrarRegistro"
                    styleClass="btn-login-registro" />
        </HBox>

        <!-- CONTENEDOR DE FORMULARIOS CON TRANSICIÓN -->
        <StackPane fx:id="stackForms" prefWidth="420">
            <children>

                <!-- FORMULARIO DE LOGIN -->
                <VBox fx:id="loginFormBox" alignment="CENTER_LEFT" spacing="14">
                    <VBox spacing="5">
                        <Label styleClass="login-label" text="Usuario">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                        <TextField fx:id="usernameField"
                                   promptText="Usuario"
                                   styleClass="login-input" />
                    </VBox>

                    <VBox spacing="5">
                        <Label styleClass="login-label" text="Contraseña" />
                        <HBox spacing="8">
                            <PasswordField fx:id="passwordField"
                                           promptText="Contraseña"
                                           styleClass="login-input"
                                           HBox.hgrow="ALWAYS" />
                            <TextField fx:id="passwordVisibleField"
                                       managed="false"
                                       visible="false"
                                       styleClass="login-input"
                                       HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>

                    <CheckBox fx:id="showPasswordCheck"
                              onAction="#togglePasswordVisibility"
                              styleClass="login-checkbox"
                              text="Mostrar contraseña" />

                    <!-- 🔹 Enlace para recuperar contraseña -->
                    <Label text="¿Olvidaste tu contraseña?"
                           onMouseClicked="#abrirRecuperarContrasena"
                           styleClass="login-forgot-link" />

                    <HBox alignment="CENTER" spacing="12">
                        <Button onAction="#login" styleClass="btn-login" text="Entrar" />
                        <Button onAction="#cancelar" styleClass="btn-cancelar" text="Cancelar" />
                    </HBox>

                    <Label fx:id="errorLabel" styleClass="login-error" text="" />

                </VBox>

                <!-- FORMULARIO DE REGISTRO -->
                <VBox fx:id="registerFormBox"
                      alignment="CENTER_LEFT"
                      spacing="12"
                      visible="false"
                      managed="false"
                      opacity="0.0">

                    <!-- FILA 1: NOMBRE / APELLIDO -->
                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label styleClass="login-label" text="Nombre" />
                            <TextField fx:id="regNombreField"
                                       promptText="Nombre"
                                       styleClass="login-input"
                                       maxWidth="Infinity" />
                        </VBox>

                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label styleClass="login-label" text="Apellido" />
                            <TextField fx:id="regApellidoField"
                                       promptText="Apellido"
                                       styleClass="login-input"
                                       maxWidth="Infinity" />
                        </VBox>
                    </HBox>

                    <!-- FILA 2: USUARIO / CÓDIGO VERIFICACIÓN -->
                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label styleClass="login-label" text="Usuario" />
                            <TextField fx:id="regUsuarioField"
                                       promptText="Usuario"
                                       styleClass="login-input"
                                       maxWidth="Infinity" />
                        </VBox>

                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label styleClass="login-label" text="Código de verificación" />
                            <TextField fx:id="regCodigoField"
                                       promptText="Código recibido"
                                       styleClass="login-input"
                                       maxWidth="Infinity" />
                        </VBox>
                    </HBox>

                    <!-- FILA 3: CORREO EN UNA LÍNEA -->
                    <VBox spacing="5">
                        <Label styleClass="login-label" text="Correo electrónico" />
                        <TextField fx:id="regCorreoField"
                                   promptText="correo@ejemplo.com"
                                   styleClass="login-input"
                                   maxWidth="Infinity" />
                    </VBox>

                    <!-- FILA 4: CONTRASEÑA / CONFIRMAR (CON CAMPOS VISIBLES/OCULTOS) -->
                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label styleClass="login-label" text="Contraseña" />
                            <StackPane>
                                <children>
                                    <PasswordField fx:id="regPasswordField"
                                                   promptText="Contraseña"
                                                   styleClass="login-input"
                                                   maxWidth="Infinity" />
                                    <TextField fx:id="regPasswordVisibleField"
                                               promptText="Contraseña"
                                               styleClass="login-input"
                                               maxWidth="Infinity"
                                               visible="false"
                                               managed="false" />
                                </children>
                            </StackPane>
                        </VBox>

                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label styleClass="login-label" text="Confirmar contraseña" />
                            <StackPane>
                                <children>
                                    <PasswordField fx:id="regConfirmPasswordField"
                                                   promptText="Confirmar contraseña"
                                                   styleClass="login-input"
                                                   maxWidth="Infinity" />
                                    <TextField fx:id="regConfirmPasswordVisibleField"
                                               promptText="Confirmar contraseña"
                                               styleClass="login-input"
                                               maxWidth="Infinity"
                                               visible="false"
                                               managed="false" />
                                </children>
                            </StackPane>
                        </VBox>
                    </HBox>

                    <!-- CHECKBOX MOSTRAR CONTRASEÑAS REGISTRO -->
                    <CheckBox fx:id="regShowPasswordCheck"
                              onAction="#toggleRegistroPasswordVisibility"
                              styleClass="login-checkbox"
                              text="Mostrar contraseñas" />

                    <!-- FILA 5: BOTONES (ENVIAR CÓDIGO / REGISTRAR) -->
                    <HBox alignment="CENTER" spacing="12" style="-fx-padding: 10 0 0 0;">
                        <Button fx:id="btnRegistroAccion"
                                onAction="#accionRegistro"
                                styleClass="btn-login"
                                text="Enviar código" />
                        <Button onAction="#cancelarRegistro"
                                styleClass="btn-cancelar"
                                text="Cancelar" />
                    </HBox>

                    <!-- MENSAJE ERROR -->
                    <Label fx:id="registerErrorLabel" styleClass="login-error" text="" />
                </VBox>

            </children>
        </StackPane>

        <Label styleClass="login-footer" text="© 2025 Polygraph - Todos los derechos reservados" />
    </VBox>
</VBox>